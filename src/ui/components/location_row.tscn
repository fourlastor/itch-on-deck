[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/components/location_row.gd" id="1_location"]

[node name="LocationRow" type="Button"]
custom_minimum_size = Vector2(0, 106)
theme_type_variation = &"LocationButton"
script = ExtResource("1_location")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 14

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Top" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Name" type="Label" parent="Margin/Column/Top"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelItemTitle"
text = "Internal"

[node name="Path" type="Label" parent="Margin/Column/Top"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"LabelBodyMuted"
text = "~/Games/itch"
text_overrun_behavior = 3

[node name="Free" type="Label" parent="Margin/Column/Top"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelFact"
text = "38 GB free"

[node name="Meter" type="ProgressBar" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"MeterBar"
max_value = 1.0
step = 0.001
show_percentage = false

[node name="Info" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelSmallMuted"
text = "6 games"
