[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/components/section_button.gd" id="1_section"]

[node name="SectionButton" type="Button"]
custom_minimum_size = Vector2(0, 76)
theme_type_variation = &"SectionButton"
toggle_mode = true
script = ExtResource("1_section")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_right = 20

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0
alignment = 1

[node name="Title" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelItemTitle"
text = "Updates"

[node name="Value" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelSmallMuted"
text = "Off"
text_overrun_behavior = 3
